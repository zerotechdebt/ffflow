diff --git a/templates/accounts/notifications.html b/templates/accounts/notifications.html
new file mode 100644
index 0000000..bc79054
--- /dev/null
+++ b/templates/accounts/notifications.html
@@ -0,0 +1,14 @@
+{% extends "base.html" %}
+{% block content %}
+<div class="container page"><h1>Notifications</h1>
+  <form method="post" action="{% url 'notifications_mark_read' %}">{% csrf_token %}
+    <button type="submit">Mark all read</button></form>
+  <ul class="notification-list">
+    {% for n in notifications %}
+      <li class="notification{% if not n.read %} unread{% endif %}">
+        {{ n.actor.username }} {{ n.verb }} {% if n.article_slug %}your article{% endif %}
+      </li>
+    {% empty %}<li>No notifications.</li>{% endfor %}
+  </ul>
+</div>
+{% endblock %}
