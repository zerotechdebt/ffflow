diff --git a/apps/articles/tests.py b/apps/articles/tests.py
new file mode 100644
index 0000000..53b47c1
--- /dev/null
+++ b/apps/articles/tests.py
@@ -0,0 +1,97 @@
+"""
+Draft (is_published) behavior tests.
+
+Most of the app is covered by the RealWorld e2e suite (make e2e), but drafts
+add author-only visibility rules that are worth pinning down directly.
+"""
+
+from django.contrib.auth import get_user_model
+from django.test import TestCase
+from django.urls import reverse
+
+from articles.models import Article
+
+User = get_user_model()
+
+
+class DraftTests(TestCase):
+    def setUp(self):
+        self.author = User.objects.create_user(email="author@example.com", username="author", password="pw")
+        self.other = User.objects.create_user(email="other@example.com", username="other", password="pw")
+
+    def _make(self, title, *, is_published=True, author=None):
+        return Article.objects.create(author=author or self.author, title=title, is_published=is_published)
+
+    def test_articles_default_to_published(self):
+        """Creating an article without specifying is_published leaves it public."""
+        article = Article.objects.create(author=self.author, title="Default article")
+        self.assertTrue(article.is_published)
+
+    def test_drafts_hidden_from_global_feed(self):
+        self._make("Published one")
+        self._make("Draft one", is_published=False)
+        response = self.client.get(reverse("home"))
+        self.assertContains(response, "Published one")
+        self.assertNotContains(response, "Draft one")
+
+    def test_draft_detail_visible_to_author_only(self):
+        draft = self._make("Secret draft", is_published=False)
+        url = reverse("article_detail", kwargs={"slug": draft.slug})
+        # Anonymous visitor gets a 404.
+        self.assertEqual(self.client.get(url).status_code, 404)
+        # A different logged-in user gets a 404.
+        self.client.force_login(self.other)
+        self.assertEqual(self.client.get(url).status_code, 404)
+        # The author can view their own draft.
+        self.client.force_login(self.author)
+        response = self.client.get(url)
+        self.assertEqual(response.status_code, 200)
+        self.assertContains(response, "Secret draft")
+
+    def test_editor_can_save_as_draft(self):
+        self.client.force_login(self.author)
+        response = self.client.post(
+            reverse("article_create"),
+            {"title": "Work in progress", "description": "", "body": "", "tags": "", "action": "draft"},
+        )
+        self.assertEqual(response.status_code, 302)
+        article = Article.objects.get(title="Work in progress")
+        self.assertFalse(article.is_published)
+
+    def test_editor_publish_button_publishes(self):
+        self.client.force_login(self.author)
+        self.client.post(
+            reverse("article_create"),
+            {"title": "Shipped", "description": "", "body": "", "tags": "", "action": "publish"},
+        )
+        self.assertTrue(Article.objects.get(title="Shipped").is_published)
+
+    def test_editing_a_draft_can_publish_it(self):
+        draft = self._make("Growing draft", is_published=False)
+        self.client.force_login(self.author)
+        self.client.post(
+            reverse("article_edit", kwargs={"slug": draft.slug}),
+            {"title": "Growing draft", "description": "", "body": "", "tags": "", "action": "publish"},
+        )
+        draft.refresh_from_db()
+        self.assertTrue(draft.is_published)
+
+    def test_profile_articles_tab_excludes_drafts(self):
+        self._make("Public post")
+        self._make("Hidden draft", is_published=False)
+        response = self.client.get(reverse("profile", kwargs={"username": "author"}))
+        self.assertContains(response, "Public post")
+        self.assertNotContains(response, "Hidden draft")
+
+    def test_drafts_tab_lists_own_drafts(self):
+        self._make("My draft", is_published=False)
+        self.client.force_login(self.author)
+        response = self.client.get(reverse("profile_drafts", kwargs={"username": "author"}))
+        self.assertContains(response, "My draft")
+
+    def test_drafts_tab_not_accessible_for_other_users(self):
+        self._make("My draft", is_published=False)
+        self.client.force_login(self.other)
+        response = self.client.get(reverse("profile_drafts", kwargs={"username": "author"}))
+        # Redirected away from someone else's drafts.
+        self.assertEqual(response.status_code, 302)
