diff --git a/templates/notifications/list.html b/templates/notifications/list.html
new file mode 100644
index 0000000..5cd6564
--- /dev/null
+++ b/templates/notifications/list.html
@@ -0,0 +1,109 @@
+{% extends "base.html" %}
+
+{% block content %}
+<div class="page">
+  <div class="container page">
+    <div class="row">
+      <div class="col-md-8 offset-md-2">
+        <h1>Notifications</h1>
+        {% if notifications %}
+          {% if unread_count > 0 %}
+            <form method="post" action="{% url 'mark_all_as_read' %}" style="margin-bottom: 20px;">
+              {% csrf_token %}
+              <button type="submit" class="btn btn-sm btn-outline-primary">Mark all as read</button>
+            </form>
+          {% endif %}
+          <ul class="notification-list">
+            {% for notification in notifications %}
+              <li class="notification-item {% if not notification.is_read %}unread{% endif %}">
+                <div class="notification-content">
+                  {% if notification.notification_type == "follow" %}
+                    <p>
+                      <strong><a href="{% url 'profile' username=notification.actor.username %}">{{ notification.actor.username }}</a></strong>
+                      started following you.
+                    </p>
+                  {% elif notification.notification_type == "favorite" %}
+                    <p>
+                      <strong><a href="{% url 'profile' username=notification.actor.username %}">{{ notification.actor.username }}</a></strong>
+                      favorited your article
+                      <strong><a href="{% url 'article_detail' slug=notification.article.slug %}">{{ notification.article.title }}</a></strong>.
+                    </p>
+                  {% elif notification.notification_type == "comment" %}
+                    <p>
+                      <strong><a href="{% url 'profile' username=notification.actor.username %}">{{ notification.actor.username }}</a></strong>
+                      commented on your article
+                      <strong><a href="{% url 'article_detail' slug=notification.article.slug %}">{{ notification.article.title }}</a></strong>.
+                    </p>
+                  {% endif %}
+                  <small class="text-muted">{{ notification.created|date:"M d, Y H:i" }}</small>
+                  {% if not notification.is_read %}
+                    <form method="post" action="{% url 'mark_as_read' notification.id %}" style="display: inline;">
+                      {% csrf_token %}
+                      <button type="submit" class="btn btn-sm btn-link">Mark as read</button>
+                    </form>
+                  {% endif %}
+                </div>
+              </li>
+            {% endfor %}
+          </ul>
+        {% else %}
+          <p>No notifications yet.</p>
+        {% endif %}
+      </div>
+    </div>
+  </div>
+</div>
+
+<style>
+  .notification-list {
+    list-style: none;
+    padding: 0;
+  }
+
+  .notification-item {
+    padding: 15px;
+    border: 1px solid #ddd;
+    margin-bottom: 10px;
+    border-radius: 4px;
+    background-color: #fff;
+  }
+
+  .notification-item.unread {
+    background-color: #f5f5f5;
+    border-left: 4px solid #5cb85c;
+  }
+
+  .notification-content {
+    display: flex;
+    flex-direction: column;
+  }
+
+  .notification-content p {
+    margin: 0 0 8px 0;
+    font-size: 14px;
+  }
+
+  .notification-content a {
+    color: #5cb85c;
+    text-decoration: none;
+  }
+
+  .notification-content a:hover {
+    text-decoration: underline;
+  }
+
+  .notification-content small {
+    font-size: 12px;
+  }
+
+  .btn-link {
+    padding: 0;
+    color: #5cb85c;
+    text-decoration: none;
+  }
+
+  .btn-link:hover {
+    text-decoration: underline;
+  }
+</style>
+{% endblock %}
