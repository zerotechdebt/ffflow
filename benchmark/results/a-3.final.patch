diff --git a/realworld/specs/e2e/drafts.spec.ts b/realworld/specs/e2e/drafts.spec.ts
new file mode 100644
index 0000000..199ca70
--- /dev/null
+++ b/realworld/specs/e2e/drafts.spec.ts
@@ -0,0 +1,117 @@
+import { test, expect } from '@playwright/test';
+import { register, generateUniqueUser } from './helpers/auth';
+import { createArticle, editArticle, generateUniqueArticle } from './helpers/articles';
+import { API_MODE } from './helpers/config';
+
+/**
+ * Draft support is a fullstack-only feature (not part of the hosted RealWorld
+ * API), so these specs only run when exercising this implementation directly.
+ */
+test.describe('Article drafts', () => {
+  test.skip(API_MODE, 'Draft support is a fullstack-only feature');
+
+  test.afterEach(async ({ context }) => {
+    await context.close();
+    await new Promise(resolve => setTimeout(resolve, 500));
+  });
+
+  test('saving a draft keeps it out of the global feed but visible to its author', async ({ page }) => {
+    const user = generateUniqueUser();
+    await register(page, user.username, user.email, user.password);
+
+    const article = generateUniqueArticle();
+    await createArticle(page, article, { draft: true });
+
+    // Author lands on the article page and sees the draft indicator.
+    await expect(page).toHaveURL(/\/article\/.+/);
+    await expect(page.locator('h1')).toContainText(article.title);
+    await expect(page.locator('.draft-badge').first()).toBeVisible();
+
+    // The draft must not surface on the public global feed.
+    await page.goto('/', { waitUntil: 'load' });
+    await expect(page.locator(`h1:has-text("${article.title}")`)).not.toBeVisible();
+  });
+
+  test('an author can find their drafts under the My Drafts tab', async ({ page }) => {
+    const user = generateUniqueUser();
+    await register(page, user.username, user.email, user.password);
+
+    const article = generateUniqueArticle();
+    await createArticle(page, article, { draft: true });
+
+    // The draft shows under My Drafts...
+    await page.goto(`/profile/${user.username}/drafts`, { waitUntil: 'load' });
+    await expect(page.locator(`.article-preview h1:has-text("${article.title}")`)).toBeVisible();
+
+    // ...but not under the public My Articles tab.
+    await page.goto(`/profile/${user.username}`, { waitUntil: 'load' });
+    await expect(page.locator(`.article-preview h1:has-text("${article.title}")`)).not.toBeVisible();
+  });
+
+  test("another user cannot view someone else's draft", async ({ page, browser }) => {
+    const author = generateUniqueUser();
+    await register(page, author.username, author.email, author.password);
+
+    const article = generateUniqueArticle();
+    await createArticle(page, article, { draft: true });
+    const draftUrl = page.url();
+
+    // A different, logged-in user hits a not-found page for the draft.
+    const ctx = await browser.newContext();
+    const other = await ctx.newPage();
+    const otherUser = generateUniqueUser();
+    await register(other, otherUser.username, otherUser.email, otherUser.password);
+
+    await other.goto(draftUrl, { waitUntil: 'load' });
+    await expect(other.locator('h1')).toHaveText('Article not found');
+    await expect(other.locator(`h1:has-text("${article.title}")`)).not.toBeVisible();
+
+    await ctx.close();
+  });
+
+  test('publishing a draft makes it public and removes it from drafts', async ({ page }) => {
+    const user = generateUniqueUser();
+    await register(page, user.username, user.email, user.password);
+
+    const article = generateUniqueArticle();
+    await createArticle(page, article, { draft: true });
+
+    const slug = page.url().split('/article/')[1];
+
+    // Re-open the editor and publish it (no field changes needed — just publish).
+    await editArticle(page, slug, {});
+
+    // The draft indicator is gone on the published article page.
+    await expect(page).toHaveURL(/\/article\/.+/);
+    await expect(page.locator('.draft-badge')).toHaveCount(0);
+
+    // Now it appears on the global feed...
+    await page.goto('/', { waitUntil: 'load' });
+    await expect(page.locator(`h1:has-text("${article.title}")`).first()).toBeVisible();
+
+    // ...and no longer under My Drafts.
+    await page.goto(`/profile/${user.username}/drafts`, { waitUntil: 'load' });
+    await expect(page.locator(`.article-preview h1:has-text("${article.title}")`)).not.toBeVisible();
+  });
+
+  test('an author can unpublish a published article back into a draft', async ({ page }) => {
+    const user = generateUniqueUser();
+    await register(page, user.username, user.email, user.password);
+
+    const article = generateUniqueArticle();
+    await createArticle(page, article);
+
+    const slug = page.url().split('/article/')[1];
+
+    // Open the editor and save it as a draft to unpublish.
+    await page.goto(`/editor/${slug}`, { waitUntil: 'load' });
+    const titleInput = page.locator('input[name="title"]');
+    await expect(titleInput).not.toHaveValue('', { timeout: 10000 });
+    await Promise.all([page.waitForURL(/\/article\/.+/), page.click('button:has-text("Save Draft")')]);
+
+    // It is now a draft and drops off the public feed.
+    await expect(page.locator('.draft-badge').first()).toBeVisible();
+    await page.goto('/', { waitUntil: 'load' });
+    await expect(page.locator(`h1:has-text("${article.title}")`)).not.toBeVisible();
+  });
+});
