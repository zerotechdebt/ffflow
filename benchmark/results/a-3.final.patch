+++ b/apps/articles/tests.py
@@ -0,0 +1,33 @@
+from django.contrib.auth import get_user_model
+from django.test import TestCase
+
+from articles.models import Article
+
+User = get_user_model()
+
+
+class ArticleDraftTest(TestCase):
+    """Draft behaviour of the Article model and queryset.
+
+    Most behaviour is covered by the Playwright e2e suite; these guard the
+    two invariants that are cheapest to assert directly: articles publish by
+    default (so existing content stays visible) and ``.published()`` hides
+    drafts.
+    """
+
+    @classmethod
+    def setUpTestData(cls):
+        cls.author = User.objects.create_user(email="author@example.com", username="author", password="password123")
+
+    def test_articles_are_published_by_default(self):
+        article = Article.objects.create(author=self.author, title="Hello world")
+        self.assertTrue(article.is_published)
+
+    def test_published_queryset_excludes_drafts(self):
+        live = Article.objects.create(author=self.author, title="Live article")
+        draft = Article.objects.create(author=self.author, title="Draft article", is_published=False)
+
+        published = Article.objects.published()
+
+        self.assertIn(live, published)
+        self.assertNotIn(draft, published)
