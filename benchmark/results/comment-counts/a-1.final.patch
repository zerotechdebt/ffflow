+    /**
+     * Script URL
+     */
+    url: string;
+
+    /**
+     * Script ID
+     */
+    scriptId: string;
+
+    /**
+     * Script content, if applicable.
+     */
+    source?: string;
+
+    /**
+     * V8-specific coverage format.
+     */
+    functions: Array<{
