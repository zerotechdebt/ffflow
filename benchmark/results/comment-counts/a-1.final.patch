+ *   } catch (error) {
+ *     if (error instanceof playwright.errors.TimeoutError)
+ *       console.log('Timeout!');
+ *   }
+ *   await browser.close();
+ * })();
+ * ```
+ *
+ */
+class TimeoutError extends Error {
