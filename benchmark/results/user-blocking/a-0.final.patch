diff --git a/realworld/specs/e2e/blocking.spec.ts b/realworld/specs/e2e/blocking.spec.ts
new file mode 100644
index 0000000..901679a
--- /dev/null
+++ b/realworld/specs/e2e/blocking.spec.ts
@@ -0,0 +1,108 @@
+import { test, expect } from '@playwright/test';
+import { register, generateUniqueUser } from './helpers/auth';
+import { createArticle, generateUniqueArticle } from './helpers/articles';
+import { blockUser, unblockUser } from './helpers/profile';
+import { API_MODE } from './helpers/config';
+
+// User blocking is a fullstack-only feature (not part of the RealWorld API
+// spec), so these tests only run against the Django + HTMX implementation.
+test.describe('User Blocking', () => {
+  test.skip(API_MODE, 'Blocking is only implemented in fullstack mode');
+
+  test.afterEach(async ({ context }) => {
+    await context.close();
+    await new Promise(resolve => setTimeout(resolve, 500));
+  });
+
+  test('should block and unblock a user', async ({ page, browser }) => {
+    const alice = generateUniqueUser();
+    await register(page, alice.username, alice.email, alice.password);
+
+    const bob = generateUniqueUser();
+    const bobCtx = await browser.newContext();
+    const bobPage = await bobCtx.newPage();
+    await register(bobPage, bob.username, bob.email, bob.password);
+    await bobCtx.close();
+
+    // Alice blocks bob: block button toggles, follow button disappears
+    await blockUser(page, bob.username);
+    await expect(page.locator('button:has-text("Unblock")')).toBeVisible();
+    await expect(page.locator('button:has-text("Follow")')).not.toBeVisible();
+
+    // Alice unblocks bob: follow button comes back
+    await unblockUser(page, bob.username);
+    await expect(page.locator('button:has-text("Follow")')).toBeVisible();
+    await expect(page.locator('button:has-text("Block")')).toBeVisible();
+  });
+
+  test('blocked user cannot follow the blocker', async ({ page, browser }) => {
+    const alice = generateUniqueUser();
+    await register(page, alice.username, alice.email, alice.password);
+
+    const bob = generateUniqueUser();
+    const bobCtx = await browser.newContext();
+    const bobPage = await bobCtx.newPage();
+    await register(bobPage, bob.username, bob.email, bob.password);
+
+    // Alice blocks bob
+    await blockUser(page, bob.username);
+
+    // Bob visits alice's profile: no Follow button available
+    await bobPage.goto(`/profile/${alice.username}`, { waitUntil: 'load' });
+    await bobPage.waitForSelector('h4', { timeout: 10000 });
+    await expect(bobPage.locator('button:has-text("Follow")')).not.toBeVisible();
+
+    await bobCtx.close();
+  });
+
+  test('blocked user cannot comment on the blockers article', async ({ page, browser }) => {
+    const alice = generateUniqueUser();
+    await register(page, alice.username, alice.email, alice.password);
+    const article = generateUniqueArticle();
+    await createArticle(page, article);
+    const articleUrl = page.url();
+
+    const bob = generateUniqueUser();
+    const bobCtx = await browser.newContext();
+    const bobPage = await bobCtx.newPage();
+    await register(bobPage, bob.username, bob.email, bob.password);
+
+    // Bob can comment before being blocked
+    await bobPage.goto(articleUrl, { waitUntil: 'load' });
+    await expect(bobPage.locator('textarea[name="body"]')).toBeVisible();
+
+    // Alice blocks bob
+    await blockUser(page, bob.username);
+
+    // Bob reloads: the comment form is gone
+    await bobPage.goto(articleUrl, { waitUntil: 'load' });
+    await bobPage.waitForSelector('#comments-section', { timeout: 10000 });
+    await expect(bobPage.locator('textarea[name="body"]')).not.toBeVisible();
+
+    await bobCtx.close();
+  });
+
+  test('can manage blocked users from settings', async ({ page, browser }) => {
+    const alice = generateUniqueUser();
+    await register(page, alice.username, alice.email, alice.password);
+
+    const bob = generateUniqueUser();
+    const bobCtx = await browser.newContext();
+    const bobPage = await bobCtx.newPage();
+    await register(bobPage, bob.username, bob.email, bob.password);
+    await bobCtx.close();
+
+    await blockUser(page, bob.username);
+
+    // Navigate to the blocked-users management page via settings
+    await page.goto('/settings', { waitUntil: 'load' });
+    await page.click('a:has-text("Manage blocked users")');
+    await expect(page).toHaveURL('/blocked');
+    await expect(page.locator(`text=${bob.username}`)).toBeVisible();
+
+    // Unblock from the management page
+    await page.click('button:has-text("Unblock")');
+    await expect(page).toHaveURL('/blocked');
+    await expect(page.locator('text=You haven\'t blocked anyone.')).toBeVisible();
+  });
+});
