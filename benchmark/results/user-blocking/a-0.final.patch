+{% extends "base.html" %}
+{% load static %}
+
+{% block content %}
+<div class="settings-page">
+  <div class="container page">
+    <div class="row">
+      <div class="col-md-6 offset-md-3 col-xs-12">
+        <h1 class="text-xs-center">Blocked Users</h1>
+        <p class="text-xs-center text-muted">
+          Blocked users can't follow you, comment on your articles, or favorite them.
+        </p>
+
+        {% if blocked_users %}
+        <ul class="list-group">
+          {% for blocked_user in blocked_users %}
+          <li class="list-group-item d-flex justify-content-between align-items-center">
+            <a href="{% url 'profile' username=blocked_user.username %}">
+              <img class="user-pic" src="{% if blocked_user.image %}{{ blocked_user.image }}{% else %}{% static 'images/default-avatar.svg' %}{% endif %}" alt="{{ blocked_user.username }}">
+              {{ blocked_user.username }}
+            </a>
+            <form method="post" action="{% url 'block' username=blocked_user.username %}" style="display:inline">
+              {% csrf_token %}
+              <input type="hidden" name="next" value="{% url 'blocked' %}">
+              <button type="submit" class="btn btn-sm btn-outline-secondary">Unblock</button>
+            </form>
+          </li>
+          {% endfor %}
+        </ul>
+        {% else %}
+        <p class="text-xs-center">You haven't blocked anyone.</p>
+        {% endif %}
+
+        <hr>
+        <a href="{% url 'settings' %}" class="btn btn-outline-secondary">Back to Settings</a>
+      </div>
+    </div>
+  </div>
+</div>
+{% endblock %}
