diff --git a/realworld/specs/e2e/blocking.spec.ts b/realworld/specs/e2e/blocking.spec.ts
new file mode 100644
index 0000000..d6b70e8
--- /dev/null
+++ b/realworld/specs/e2e/blocking.spec.ts
@@ -0,0 +1,71 @@
+import { test, expect } from '@playwright/test';
+import { register, login, logout, generateUniqueUser } from './helpers/auth';
+import { createArticle, generateUniqueArticle } from './helpers/articles';
+import { blockUser, unblockUser } from './helpers/profile';
+import { API_MODE } from './helpers/config';
+
+// User blocking is a fullstack-only extension (not part of the RealWorld API spec).
+test.describe('User Blocking', () => {
+  test.skip(API_MODE, 'Blocking is a fullstack-only feature');
+
+  test.afterEach(async ({ context }) => {
+    await context.close();
+    await new Promise(resolve => setTimeout(resolve, 500));
+  });
+
+  test('should block and unblock a user from their profile', async ({ page }) => {
+    const target = generateUniqueUser();
+    await register(page, target.username, target.email, target.password);
+    await logout(page);
+
+    const blocker = generateUniqueUser();
+    await register(page, blocker.username, blocker.email, blocker.password);
+
+    // Block the target; the Follow button should disappear.
+    await blockUser(page, target.username);
+    await expect(page.locator('button:has-text("Unblock")')).toBeVisible();
+    await expect(page.locator('button:has-text("Follow")')).not.toBeVisible();
+
+    // Managed via the blocked-users page.
+    await page.goto('/settings/blocked', { waitUntil: 'load' });
+    await expect(page.locator('.blocked-user-row')).toContainText(target.username);
+
+    // Unblock from the profile; Follow returns.
+    await unblockUser(page, target.username);
+    await expect(page.locator('button:has-text("Follow")')).toBeVisible();
+
+    await page.goto('/settings/blocked', { waitUntil: 'load' });
+    await expect(page.locator('.blocked-user-row')).toHaveCount(0);
+  });
+
+  test('a blocked user cannot follow or interact with the blocker', async ({ page }) => {
+    // Blocker registers and publishes an article, then blocks the other user.
+    const blocker = generateUniqueUser();
+    await register(page, blocker.username, blocker.email, blocker.password);
+    const article = generateUniqueArticle();
+    await createArticle(page, article);
+    const articleUrl = page.url();
+
+    const blocked = generateUniqueUser();
+    // Pre-create the blocked user so the blocker can block them.
+    await logout(page);
+    await register(page, blocked.username, blocked.email, blocked.password);
+    await logout(page);
+
+    // Blocker blocks the other user.
+    await login(page, blocker.email, blocker.password);
+    await blockUser(page, blocked.username);
+    await logout(page);
+
+    // The blocked user can no longer follow the blocker.
+    await login(page, blocked.email, blocked.password);
+    await page.goto(`/profile/${blocker.username}`, { waitUntil: 'load' });
+    await expect(page.locator('button:has-text("Follow")')).not.toBeVisible();
+    await expect(page.locator('#profile-actions')).toContainText('has blocked you');
+
+    // ...and cannot comment on or favorite the blocker's article.
+    await page.goto(articleUrl, { waitUntil: 'load' });
+    await expect(page.locator('.comment-form')).not.toBeVisible();
+    await expect(page.locator('.article-actions button:has-text("Favorite")')).not.toBeVisible();
+  });
+});
