@@ -0,0 +1,12 @@
+<span id="profile-actions">
+  {% if user.is_authenticated and user != profile_user %}
+    {% if is_blocked %}
+      <span class="btn btn-sm btn-outline-secondary action-btn disabled" aria-disabled="true">
+        <i class="ion-locked"></i>&nbsp;{{ profile_user.username }} has blocked you
+      </span>
+    {% elif not has_blocked %}
+      {% include "partials/follow_button.html" %}
+    {% endif %}
+    {% include "partials/block_button.html" %}
+  {% endif %}
+</span>
