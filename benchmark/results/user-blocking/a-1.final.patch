@@ -0,0 +1,107 @@
+"""
+Tests for the user blocking feature.
+
+The bulk of behaviour is covered by the e2e suite; these tests pin the
+server-side enforcement rules that are easy to get wrong: block helpers,
+follow/interaction guards, and the block toggle severing follows.
+"""
+
+from articles.models import Article
+from django.contrib.auth import get_user_model
+from django.test import TestCase
+from django.urls import reverse
+
+User = get_user_model()
+
+
+class BlockingTestBase(TestCase):
+    def setUp(self):
+        self.alice = User.objects.create_user(email="alice@example.com", username="alice", password="pw")
+        self.bob = User.objects.create_user(email="bob@example.com", username="bob", password="pw")
+
+
+class BlockModelTest(BlockingTestBase):
+    def test_has_blocked_and_is_blocked_by(self):
+        self.alice.blocked.add(self.bob)
+        self.assertTrue(self.alice.has_blocked(self.bob))
+        self.assertFalse(self.bob.has_blocked(self.alice))
+        self.assertTrue(self.bob.is_blocked_by(self.alice))
+        self.assertFalse(self.alice.is_blocked_by(self.bob))
+
+    def test_is_blocking_or_blocked_by_is_symmetric(self):
+        self.alice.blocked.add(self.bob)
+        self.assertTrue(self.alice.is_blocking_or_blocked_by(self.bob))
+        self.assertTrue(self.bob.is_blocking_or_blocked_by(self.alice))
+
+
+class BlockViewTest(BlockingTestBase):
+    def test_block_toggle_adds_and_removes(self):
+        self.client.force_login(self.alice)
+        url = reverse("block", kwargs={"username": "bob"})
+
+        self.client.post(url)
+        self.assertTrue(self.alice.has_blocked(self.bob))
+
+        self.client.post(url)
+        self.assertFalse(self.alice.has_blocked(self.bob))
+
+    def test_blocking_severs_follow_both_ways(self):
+        # bob follows alice and alice follows bob
+        self.alice.followers.add(self.bob)
+        self.bob.followers.add(self.alice)
+
+        self.client.force_login(self.alice)
+        self.client.post(reverse("block", kwargs={"username": "bob"}))
+
+        self.assertFalse(self.bob.is_following(self.alice))
+        self.assertFalse(self.alice.is_following(self.bob))
+
+    def test_cannot_block_self(self):
+        self.client.force_login(self.alice)
+        self.client.post(reverse("block", kwargs={"username": "alice"}))
+        self.assertFalse(self.alice.has_blocked(self.alice))
+
+
+class BlockedInteractionTest(BlockingTestBase):
+    def test_blocked_user_cannot_follow(self):
+        # alice blocks bob; bob must not be able to follow alice
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.bob)
+        self.client.post(reverse("follow", kwargs={"username": "alice"}))
+        self.assertFalse(self.bob.is_following(self.alice))
+
+    def test_blocker_cannot_follow_blocked_user(self):
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.alice)
+        self.client.post(reverse("follow", kwargs={"username": "bob"}))
+        self.assertFalse(self.alice.is_following(self.bob))
+
+    def test_blocked_user_cannot_comment(self):
+        article = Article.objects.create(author=self.alice, title="Hi", slug="hi", content="body")
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.bob)
+        response = self.client.post(reverse("comment_create", kwargs={"slug": "hi"}), {"body": "hello"})
+        self.assertEqual(response.status_code, 403)
+        self.assertEqual(article.comment_set.count(), 0)
+
+    def test_blocked_user_cannot_favorite(self):
+        Article.objects.create(author=self.alice, title="Hi", slug="hi", content="body")
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.bob)
+        response = self.client.post(reverse("article_favorite", kwargs={"slug": "hi"}))
+        self.assertEqual(response.status_code, 403)
+
+
+class BlockedUsersPageTest(BlockingTestBase):
+    def test_page_lists_blocked_users(self):
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.alice)
+        response = self.client.get(reverse("blocked_users"))
+        self.assertEqual(response.status_code, 200)
+        self.assertContains(response, "bob")
+
+    def test_unblock_from_list_context(self):
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.alice)
+        self.client.post(reverse("block", kwargs={"username": "bob"}), {"context": "list"})
+        self.assertFalse(self.alice.has_blocked(self.bob))
