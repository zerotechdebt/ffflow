+                "is_following": request.user.is_following(profile_user),
+            },
+        )
+    return redirect("blocked_users") if from_list else redirect("profile", username=username)
+
+
+@login_required
+def blocked_users_view(request):
+    blocked_users = request.user.blocked.order_by("username")
+    return render(request, "accounts/blocked_users.html", {"blocked_users": blocked_users})
