+  const unblockBtn = page.getByRole('button', { name: new RegExp(`Unblock ${username}`) });
+  await unblockBtn.waitFor({ timeout: 10000 });
+  await unblockBtn.click();
+  // Wait for the button to toggle back to Block
+  await page.getByRole('button', { name: new RegExp(`Block ${username}`) }).waitFor({ timeout: 5000 });
+}
