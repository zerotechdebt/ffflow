+++ b/apps/accounts/tests.py
@@ -0,0 +1,93 @@
+"""Unit tests for the user-blocking feature.
+
+These cover the model-level relationship helpers and the server-side
+enforcement that prevents a blocked user from following or interacting with
+the blocker. Browser-level behavior (buttons, management page) is covered by
+the Playwright e2e suite.
+"""
+
+from articles.models import Article
+from comments.models import Comment
+from django.contrib.auth import get_user_model
+from django.test import TestCase
+from django.urls import reverse
+
+User = get_user_model()
+
+
+class BlockingModelTest(TestCase):
+    def setUp(self):
+        self.alice = User.objects.create_user(email="alice@example.com", username="alice", password="pw")
+        self.bob = User.objects.create_user(email="bob@example.com", username="bob", password="pw")
+
+    def test_has_blocked_and_is_blocked_by(self):
+        self.alice.blocked.add(self.bob)
+        self.assertTrue(self.alice.has_blocked(self.bob))
+        self.assertFalse(self.bob.has_blocked(self.alice))
+        self.assertTrue(self.bob.is_blocked_by(self.alice))
+        self.assertFalse(self.alice.is_blocked_by(self.bob))
+
+    def test_blocked_by_reverse_accessor(self):
+        self.alice.blocked.add(self.bob)
+        self.assertIn(self.alice, self.bob.blocked_by.all())
+        self.assertIn(self.bob, self.alice.blocked.all())
+
+
+class BlockingViewTest(TestCase):
+    def setUp(self):
+        self.alice = User.objects.create_user(email="alice@example.com", username="alice", password="pw")
+        self.bob = User.objects.create_user(email="bob@example.com", username="bob", password="pw")
+
+    def test_block_severs_existing_follows_both_ways(self):
+        # Alice follows Bob and Bob follows Alice.
+        self.bob.followers.add(self.alice)
+        self.alice.followers.add(self.bob)
+        self.assertTrue(self.alice.is_following(self.bob))
+        self.assertTrue(self.bob.is_following(self.alice))
+
+        self.client.force_login(self.alice)
+        self.client.post(reverse("block", kwargs={"username": "bob"}))
+
+        self.assertTrue(self.alice.has_blocked(self.bob))
+        self.assertFalse(self.alice.is_following(self.bob))
+        self.assertFalse(self.bob.is_following(self.alice))
+
+    def test_block_is_a_toggle(self):
+        self.client.force_login(self.alice)
+        url = reverse("block", kwargs={"username": "bob"})
+        self.client.post(url)
+        self.assertTrue(self.alice.has_blocked(self.bob))
+        self.client.post(url)
+        self.assertFalse(self.alice.has_blocked(self.bob))
+
+    def test_blocked_user_cannot_follow_blocker(self):
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.bob)
+        self.client.post(reverse("follow", kwargs={"username": "alice"}))
+        self.assertFalse(self.bob.is_following(self.alice))
+
+    def test_blocked_user_cannot_favorite_authors_article(self):
+        article = Article.objects.create(author=self.alice, title="Alice post", content="hi")
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.bob)
+        response = self.client.post(reverse("article_favorite", kwargs={"slug": article.slug}))
+        self.assertEqual(response.status_code, 403)
+        self.assertFalse(article.favorites.filter(pk=self.bob.pk).exists())
+
+    def test_blocked_user_cannot_comment_on_authors_article(self):
+        article = Article.objects.create(author=self.alice, title="Alice post 2", content="hi")
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.bob)
+        response = self.client.post(
+            reverse("comment_create", kwargs={"slug": article.slug}),
+            {"body": "let me in"},
+        )
+        self.assertEqual(response.status_code, 403)
+        self.assertFalse(Comment.objects.filter(article=article, author=self.bob).exists())
+
+    def test_blocked_users_management_page_lists_blocked(self):
+        self.alice.blocked.add(self.bob)
+        self.client.force_login(self.alice)
+        response = self.client.get(reverse("blocked_users"))
+        self.assertEqual(response.status_code, 200)
+        self.assertContains(response, "bob")
