+{% extends "base.html" %}
+{% load static %}
+
+{% block content %}
+<div class="settings-page">
+  <div class="container page">
+    <div class="row">
+      <div class="col-md-6 offset-md-3 col-xs-12">
+        <h1 class="text-xs-center">Blocked Users</h1>
+        <p class="text-xs-center text-muted">
+          Blocked users can't follow you or interact with your articles.
+        </p>
+
+        <ul class="blocked-user-list" style="list-style:none;padding:0">
+          {% for blocked in blocked_users %}
+          <li class="blocked-user-row"
+              style="display:flex;align-items:center;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid #eee">
+            <a href="{% url 'profile' username=blocked.username %}" class="blocked-user-name">
+              <img src="{% if blocked.image %}{{ blocked.image }}{% else %}{% static 'images/default-avatar.svg' %}{% endif %}"
+                   class="user-pic" alt="{{ blocked.username }}">
+              {{ blocked.username }}
+            </a>
+            <button class="btn btn-sm btn-outline-danger"
+                    hx-post="{% url 'block' username=blocked.username %}"
+                    hx-vals='{"source": "list"}'
+                    hx-target="closest .blocked-user-row" hx-swap="outerHTML">
+              Unblock
+            </button>
+          </li>
+          {% empty %}
+          <li class="blocked-user-empty text-xs-center text-muted">You haven't blocked anyone.</li>
+          {% endfor %}
+        </ul>
+
+        <a href="{% url 'settings' %}" class="btn btn-outline-secondary">Back to Settings</a>
+      </div>
+    </div>
+  </div>
+</div>
+{% endblock %}
