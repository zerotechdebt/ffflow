     }
+
+
+def blocking_context(request):
+    """Expose the current user's block relationships as id sets for templates.
+
+    ``blocked_user_ids`` are users the current user has blocked; ``blocked_by_user_ids``
+    are users who have blocked the current user. Computed once per request so templates
+    can gate interaction controls with a cheap membership test.
+    """
+    if not request.user.is_authenticated:
+        return {"blocked_user_ids": set(), "blocked_by_user_ids": set()}
+    return {
+        "blocked_user_ids": set(request.user.blocked.values_list("id", flat=True)),
+        "blocked_by_user_ids": set(request.user.blocked_by.values_list("id", flat=True)),
+    }
diff --git a/realworld/specs/e2e/blocking.spec.ts b/realworld/specs/e2e/blocking.spec.ts
new file mode 100644
index 0000000..57f20e9
--- /dev/null
+++ b/realworld/specs/e2e/blocking.spec.ts
@@ -0,0 +1,96 @@
+import { test, expect } from '@playwright/test';
+import { register, generateUniqueUser } from './helpers/auth';
+import { blockUser, unblockUser, followUser } from './helpers/profile';
+import { createUserInIsolation } from './helpers/setup';
+
+test.describe('User Blocking', () => {
+  test.afterEach(async ({ context }) => {
+    // Mirror social.spec.ts: close the context and pause to avoid resource
+    // exhaustion flakiness when several isolated contexts run in sequence.
+    await context.close();
+    await new Promise(resolve => setTimeout(resolve, 500));
+  });
+
+  test('should block and unblock a user from their profile', async ({ page, browser }) => {
+    const me = generateUniqueUser();
+    await register(page, me.username, me.email, me.password);
+
+    const other = generateUniqueUser();
+    await createUserInIsolation(browser, other);
+
+    await page.goto(`/profile/${other.username}`, { waitUntil: 'load' });
+    await expect(page.getByRole('button', { name: new RegExp(`Follow ${other.username}`) })).toBeVisible();
+
+    await blockUser(page, other.username);
+
+    // Once blocked, the follow affordance disappears and Unblock is shown.
+    await expect(page.getByRole('button', { name: new RegExp(`Unblock ${other.username}`) })).toBeVisible();
+    await expect(page.getByRole('button', { name: new RegExp(`Follow ${other.username}`) })).not.toBeVisible();
+
+    await unblockUser(page, other.username);
+
+    // Unblocking restores the Follow affordance.
+    await expect(page.getByRole('button', { name: new RegExp(`Block ${other.username}`) })).toBeVisible();
+    await expect(page.getByRole('button', { name: new RegExp(`Follow ${other.username}`) })).toBeVisible();
+  });
+
+  test('a blocked user cannot follow the blocker', async ({ page, browser }) => {
+    // A = the blocker (this page), B = the blocked user (isolated context).
+    const a = generateUniqueUser();
+    await register(page, a.username, a.email, a.password);
+
+    const b = generateUniqueUser();
+    const bCtx = await browser.newContext();
+    const bPage = await bCtx.newPage();
+    await register(bPage, b.username, b.email, b.password);
+
+    // A blocks B.
+    await blockUser(page, b.username);
+
+    // B visits A's profile: no Follow button should be available.
+    await bPage.goto(`/profile/${a.username}`, { waitUntil: 'load' });
+    await bPage.waitForSelector('h4');
+    await expect(bPage.getByRole('button', { name: new RegExp(`Follow ${a.username}`) })).not.toBeVisible();
+
+    await bCtx.close();
+  });
+
+  test('blocking severs an existing follow relationship', async ({ page, browser }) => {
+    const me = generateUniqueUser();
+    await register(page, me.username, me.email, me.password);
+
+    const other = generateUniqueUser();
+    await createUserInIsolation(browser, other);
+
+    // Follow first, then block.
+    await followUser(page, other.username);
+    await blockUser(page, other.username);
+
+    // After unblocking we should be back to a "Follow" state, not "Unfollow".
+    await unblockUser(page, other.username);
+    await expect(page.getByRole('button', { name: new RegExp(`Follow ${other.username}`) })).toBeVisible();
+    await expect(page.getByRole('button', { name: new RegExp(`Unfollow ${other.username}`) })).not.toBeVisible();
+  });
+
+  test('should manage blocked users from the settings page', async ({ page, browser }) => {
+    const me = generateUniqueUser();
+    await register(page, me.username, me.email, me.password);
+
+    const other = generateUniqueUser();
+    await createUserInIsolation(browser, other);
+
+    await blockUser(page, other.username);
+
+    // Reach the management page via the Settings link.
+    await page.goto('/settings', { waitUntil: 'load' });
+    await page.click('a:has-text("Manage Blocked Users")');
+    await expect(page).toHaveURL('/settings/blocked');
+
+    const row = page.locator('.blocked-user-row', { hasText: other.username });
+    await expect(row).toBeVisible();
+
+    // Unblock from the list removes the row.
+    await row.getByRole('button', { name: 'Unblock' }).click();
+    await expect(page.locator('.blocked-user-row', { hasText: other.username })).not.toBeVisible();
+  });
+});
