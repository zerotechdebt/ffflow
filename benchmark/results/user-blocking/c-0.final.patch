+
+# Returns true if argument is a file:// URL or path
+is_file_url_or_path()
+{
+    if echo "$1" | grep -q '^file://' \
+            || ! echo "$1" | egrep -q '^[[:alpha:]+\.\-]+:'; then
+        return 0
+    else
+        return 1
+    fi
