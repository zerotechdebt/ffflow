+import { isSeq, isPair, isMap } from '../../nodes/identity.js';
+import { createPair, Pair } from '../../nodes/Pair.js';
+import { Scalar } from '../../nodes/Scalar.js';
+import { YAMLSeq } from '../../nodes/YAMLSeq.js';
